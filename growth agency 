    jadam: "A light foliar spray of JMS can promote lush, vigorous leaf growth."
  },
  Onions: {
    icon: <Sprout className="w-6 h-6 text-purple-400" />,
    planting: "Plant sets or transplants early in the spring. Keep weed-free as onions do not compete well for nutrients.",
    watering: "Consistent moisture until the bulbs swell. Stop watering when the tops begin to yellow and fall over.",
    trellis: "Not needed.",
    jadam: "Apply JLF rich in phosphorus and potassium as bulbs begin to form to increase size and storage life."
  },
  Grapes: {
    icon: <Leaf className="w-6 h-6 text-purple-600" />,
    planting: "Plant dormant bare-root vines in early spring. Requires deep, well-draining soil and a location with full sun.",
    watering: "Water deeply but infrequently once established. Roots can go very deep.",
    trellis: "Requires a robust, permanent trellis system (like high-cordon or pergola) to support woody vines and heavy fruit clusters.",
    jadam: "Preventative JMS and JWA (JADAM Wetting Agent) sprays in humid weather to prevent downy and powdery mildew."
  }
};

export default function Dashboard() {
  const [activeTab, setActiveTab] = useState('garden');
  
  // Garden Assistant State
  const [selectedCrop, setSelectedCrop] = useState('Tomatoes');

  // Challenger Agent State
  const [challengeInput, setChallengeInput] = useState('');
  const [challengeResult, setChallengeResult] = useState(null);
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState('');

  // Footer State
  const [showToast, setShowToast] = useState(false);

  const handleChallenge = async () => {
    if (!challengeInput.trim()) return;
    
    setIsLoading(true);
    setError('');
    setChallengeResult(null);

    try {
      const payload = {
        contents: [{ parts: [{ text: challengeInput }] }],
        systemInstruction: {
            parts: [{ text: "You are the Challenger Agent. Your job is to critically analyze a claim or plan. Be objective, thorough, and slightly skeptical but constructive." }]
        },
        generationConfig: {
            responseMimeType: "application/json",
            responseSchema: {
                type: "OBJECT",
                properties: {
                    hiddenAssumptions: {
                        type: "ARRAY",
                        description: "List of unstated beliefs or premises the claim relies on.",
                        items: { type: "STRING" }
                    },
                    counterarguments: {
                        type: "ARRAY",
                        description: "Strong arguments against the claim.",
                        items: { type: "STRING" }
                    },
                    risks: {
                        type: "ARRAY",
                        description: "Potential points of failure or negative consequences.",
                        items: { type: "STRING" }
                    },
                    alternativeViews: {
                        type: "ARRAY",
                        description: "Different perspectives or ways to frame the issue.",
                        items: { type: "STRING" }
                    },
                    assessment: {
                        type: "STRING",
                        description: "A final, concise paragraph summarizing the viability of the claim."
                    }
                },
                required: ["hiddenAssumptions", "counterarguments", "risks", "alternativeViews", "assessment"]
            }
        }
      };

      const apiKey = ""; // API key is provided by the environment
      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

      const response = await fetch(apiUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
      });

      if (!response.ok) {
        throw new Error('Failed to communicate with the Challenger Agent.');
      }

      const result = await response.json();
      
      if (result.candidates && result.candidates.length > 0) {
        const jsonText = result.candidates[0].content.parts[0].text;
        setChallengeResult(JSON.parse(jsonText));
      } else {
        throw new Error('Received unexpected response format.');
      }
    } catch (err) {
      console.error(err);
      setError('Error processing your claim. Please try again.');
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 font-sans flex flex-col">
      
      {/* Header / Tabs */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-10">
        <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center h-16">
            <div className="flex items-center space-x-2">
              <Leaf className="w-6 h-6 text-emerald-600" />
              <span className="font-bold text-xl tracking-tight text-slate-800">My Dashboard</span>
            </div>
            <nav className="flex space-x-4">
              <button
                onClick={() => setActiveTab('garden')}
                className={`px-4 py-2 rounded-md font-medium transition-colors ${
                  activeTab === 'garden' 
                    ? 'bg-emerald-100 text-emerald-800' 
                    : 'text-slate-600 hover:bg-slate-100'
                }`}
              >
                Garden Assistant
              </button>
              <button
                onClick={() => setActiveTab('challenger')}
                className={`px-4 py-2 rounded-md font-medium transition-colors ${
                  activeTab === 'challenger' 
                    ? 'bg-blue-100 text-blue-800' 
                    : 'text-slate-600 hover:bg-slate-100'
                }`}
              >
                Challenger Agent
              </button>
            </nav>
          </div>
        </div>
      </header>

      {/* Main Content Area */}
      <main className="flex-grow max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
        
        {activeTab === 'garden' && (
          <div className="animate-in fade-in slide-in-from-bottom-4 duration-500">
            <div className="mb-8">
              <h1 className="text-3xl font-bold text-slate-900 flex items-center">
                <Sprout className="w-8 h-8 mr-3 text-emerald-600" />
                Garden Assistant
              </h1>
              <p className="text-slate-600 mt-2">Select a crop to view optimal planting, watering, and care strategies.</p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
              {/* Sidebar Crop List */}
              <div className="md:col-span-1 flex flex-col space-y-2">
                {Object.keys(cropData).map(crop => (
                  <button
                    key={crop}
                    onClick={() => setSelectedCrop(crop)}
                    className={`flex items-center px-4 py-3 rounded-lg text-left transition-all ${
                      selectedCrop === crop
                        ? 'bg-emerald-600 text-white shadow-md'
                        : 'bg-white border border-slate-200 text-slate-700 hover:bg-emerald-50 hover:border-emerald-200'
                    }`}
                  >
                    <span className="mr-3">{cropData[crop].icon}</span>
                    <span className="font-medium">{crop}</span>
                  </button>
                ))}
              </div>

              {/* Crop Details Panel */}
              <div className="md:col-span-3">
                <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8">
                  <h2 className="text-2xl font-bold text-slate-800 mb-6 border-b border-slate-100 pb-4">
                    {selectedCrop} Guide
                  </h2>
                  
                  <div className="space-y-6">
                    <div className="flex gap-4">
                      <div className="mt-1 bg-amber-100 p-2 rounded-lg h-fit text-amber-700">
                        <Sprout className="w-5 h-5" />
                      </div>
                      <div>
                        <h3 className="font-semibold text-lg text-slate-800">Planting & Placement</h3>
                        <p className="text-slate-600 leading-relaxed mt-1">{cropData[selectedCrop].planting}</p>
                      </div>
                    </div>

                    <div className="flex gap-4">
                      <div className="mt-1 bg-blue-100 p-2 rounded-lg h-fit text-blue-700">
                        <Droplet className="w-5 h-5" />
                      </div>
                      <div>
                        <h3 className="font-semibold text-lg text-slate-800">Watering Schedule</h3>
                        <p className="text-slate-600 leading-relaxed mt-1">{cropData[selectedCrop].watering}</p>
                      </div>
                    </div>

                    <div className="flex gap-4">
                      <div className="mt-1 bg-slate-100 p-2 rounded-lg h-fit text-slate-700">
                        <Fence className="w-5 h-5" />
                      </div>
                      <div>
                        <h3 className="font-semibold text-lg text-slate-800">Trellis & Support</h3>
                        <p className="text-slate-600 leading-relaxed mt-1">{cropData[selectedCrop].trellis}</p>
                      </div>
                    </div>

                    <div className="flex gap-4">
                      <div className="mt-1 bg-purple-100 p-2 rounded-lg h-fit text-purple-700">
                        <FlaskConical className="w-5 h-5" />
                      </div>
                      <div>
                        <h3 className="font-semibold text-lg text-slate-800">JADAM Protocol</h3>
                        <p className="text-slate-600 leading-relaxed mt-1">{cropData[selectedCrop].jadam}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'challenger' && (
          <div className="animate-in fade-in slide-in-from-bottom-4 duration-500 max-w-4xl mx-auto">
            <div className="mb-8 text-center">
              <h1 className="text-3xl font-bold text-slate-900 flex items-center justify-center">
                <ShieldAlert className="w-8 h-8 mr-3 text-blue-600" />
                Challenger Agent
              </h1>
              <p className="text-slate-600 mt-2 max-w-2xl mx-auto">
                Submit a claim, idea, or plan. The agent will rigorously analyze it to expose hidden assumptions, risks, and alternatives.
              </p>
            </div>

            <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6 mb-8">
              <label htmlFor="claim" className="block text-sm font-medium text-slate-700 mb-2">
                Your Claim or Idea
              </label>
              <textarea
                id="claim"
                rows={4}
                className="w-full rounded-lg border-slate-300 border p-4 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow resize-none"
                placeholder="e.g., Implementing a 4-day work week will increase overall company productivity by 20%..."
                value={challengeInput}
                onChange={(e) => setChallengeInput(e.target.value)}
              />
              <div className="mt-4 flex justify-end">
                <button
                  onClick={handleChallenge}
                  disabled={isLoading || !challengeInput.trim()}
                  className="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                >
                  {isLoading ? (
                    <span className="flex items-center">
                      <svg className="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
                        <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                      </svg>
                      Analyzing...
                    </span>
                  ) : (
                    <span className="flex items-center">
                      <Send className="w-5 h-5 mr-2" />
                      Challenge This
                    </span>
                  )}
                </button>
              </div>
            </div>

            {error && (
              <div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-8" role="alert">
                {error}
              </div>
            )}

            {challengeResult && (
              <div className="space-y-6 animate-in fade-in duration-700">
                
                {/* Assessment Summary */}
                <div className="bg-slate-800 text-white rounded-xl p-6 shadow-lg border border-slate-700">
                  <h3 className="text-xl font-bold flex items-center mb-3">
                    <CheckCircle2 className="w-6 h-6 mr-2 text-emerald-400" />
                    Challenger Assessment
                  </h3>
                  <p className="text-slate-300 leading-relaxed text-lg">
                    {challengeResult.assessment}
                  </p>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {/* Hidden Assumptions */}
                  <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                    <h4 className="text-lg font-bold text-slate-800 flex items-center mb-4 pb-2 border-b border-slate-100">
                      <Lightbulb className="w-5 h-5 mr-2 text-amber-500" />
                      Hidden Assumptions
                    </h4>
                    <ul className="space-y-3">
                      {challengeResult.hiddenAssumptions.map((item, idx) => (
                        <li key={idx} className="flex items-start">
                          <span className="inline-block w-2 h-2 rounded-full bg-amber-500 mt-2 mr-3 flex-shrink-0"></span>
                          <span className="text-slate-600">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Risks & Failure Points */}
                  <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                    <h4 className="text-lg font-bold text-slate-800 flex items-center mb-4 pb-2 border-b border-slate-100">
                      <AlertTriangle className="w-5 h-5 mr-2 text-red-500" />
                      Risks / Failure Points
                    </h4>
                    <ul className="space-y-3">
                      {challengeResult.risks.map((item, idx) => (
                        <li key={idx} className="flex items-start">
                          <span className="inline-block w-2 h-2 rounded-full bg-red-500 mt-2 mr-3 flex-shrink-0"></span>
                          <span className="text-slate-600">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Counterarguments */}
                  <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                    <h4 className="text-lg font-bold text-slate-800 flex items-center mb-4 pb-2 border-b border-slate-100">
                      <ShieldAlert className="w-5 h-5 mr-2 text-blue-500" />
                      Counterarguments
                    </h4>
                    <ul className="space-y-3">
                      {challengeResult.counterarguments.map((item, idx) => (
                        <li key={idx} className="flex items-start">
                          <span className="inline-block w-2 h-2 rounded-full bg-blue-500 mt-2 mr-3 flex-shrink-0"></span>
                          <span className="text-slate-600">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Alternative Views */}
                  <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                    <h4 className="text-lg font-bold text-slate-800 flex items-center mb-4 pb-2 border-b border-slate-100">
                      <Scale className="w-5 h-5 mr-2 text-purple-500" />
                      Alternative Views
                    </h4>
                    <ul className="space-y-3">
                      {challengeResult.alternativeViews.map((item, idx) => (
                        <li key={idx} className="flex items-start">
                          <span className="inline-block w-2 h-2 rounded-full bg-purple-500 mt-2 mr-3 flex-shrink-0"></span>
                          <span className="text-slate-600">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            )}
          </div>
        )}
      </main>

      <footer className="bg-slate-900 text-slate-300 py-12 mt-auto border-t-4 border-emerald-500">
        <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative">
          
          <div className="mb-6 flex justify-center">
            <Code className="w-10 h-10 text-emerald-400 opacity-80" />
          </div>
          
          <h2 className="text-2xl font-bold text-white mb-2 tracking-wide">DBPC Restoration</h2>
          <p className="text-emerald-400 font-medium mb-6">"This is my first website"</p>
          
          <div className="flex justify-center mb-8 relative">
            <button
              onClick={() => {
                setShowToast(true);
                setTimeout(() => setShowToast(false), 3000);
              }}
              className="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2 px-6 rounded-full shadow-lg transition-transform transform hover:scale-105 active:scale-95"
            >
              Click Me
            </button>

            {/* Custom Toast Notification */}
            {showToast && (
              <div className="absolute -top-12 left-1/2 transform -translate-x-1/2 bg-white text-slate-900 px-4 py-2 rounded shadow-xl font-bold animate-in fade-in slide-in-from-bottom-2 whitespace-nowrap">
                🎉 Welcome to the real DBPC! 🎉
              </div>
            )}
          </div>

          <div className="text-sm text-slate-500 border-t border-slate-700 pt-6 flex flex-col md:flex-row justify-center items-center gap-4">
            <span>Garden Assistant</span>
            <span className="hidden md:inline">•</span>
            <span>Challenger Agent</span>
            <span className="hidden md:inline">•</span>
            <span>Built step by step</span>
          </div>
        </div>
      </footer>
    </div>
  );
}