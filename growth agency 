    trellis: "Highly recommended to use sturdy cattle panel arches. Train the main vines up the panels and prune suckers for better airflow.",
    jadam: "Foliar feed with diluted JADAM Liquid Fertilizer (JLF) once flowers appear to encourage robust fruiting."
  },
  Potatoes: {
    icon: <Sprout className="w-6 h-6 text-yellow-700" />,
    planting: "Plant seed potatoes in trenches or deep pallet raised beds. Hill soil or straw around the stems as they grow to maximize yield.",
    watering: "Keep soil moist but not waterlogged. Stop watering when foliage begins to die back before harvest.",
    trellis: "Not applicable. Requires loose, deep soil rather than vertical support.",
    jadam: "Soak seed potatoes in a highly diluted JMS solution for 10 minutes before planting to inoculate with beneficial microbes."
  },
  Melons: {
    icon: <Leaf className="w-6 h-6 text-green-500" />,
    planting: "Sow in mounds or hills to improve drainage and soil warmth. They thrive in heat and rich organic matter.",
    watering: "Heavy water needs during early growth and fruit set. Reduce watering slightly as fruit approaches maturity to concentrate sugars.",
    trellis: "Can be grown vertically on cattle panel arches to save space! Use pantyhose or mesh hammocks to support the heavy hanging fruit.",
    jadam: "Regular JMS soil drenches help combat powdery mildew and soil-borne pathogens."
  },
  Lettuce: {
    icon: <Leaf className="w-6 h-6 text-green-400" />,
    planting: "Sow successively every 2 weeks for a continuous harvest. Prefers cooler weather; plant in the shade of taller crops in summer.",
    watering: "Shallow root systems require frequent, light watering to keep leaves crisp and prevent early bolting.",
