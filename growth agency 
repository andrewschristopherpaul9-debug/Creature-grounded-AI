import React, { useState, useEffect } from 'react';
import { 
  Leaf, 
  ShieldAlert, 
  Sprout, 
  Droplet, 
  Fence, 
  FlaskConical, 
  Send, 
  CheckCircle2, 
  AlertTriangle, 
  Lightbulb, 
  Scale,
  Code
} from 'lucide-react';

const cropData = {
  Corn: {
    icon: <Sprout className="w-6 h-6" />,
    planting: "Plant in blocks of at least 4x4 for optimal wind pollination. Sow seeds 1 inch deep and 9-12 inches apart in pallet raised beds.",
    watering: "Requires 1-1.5 inches of water per week. Keep soil evenly moist, especially during tasseling and ear formation.",
    trellis: "No trellis needed, but plant taller varieties on the north side of the garden so they don't shade out other crops.",
    jadam: "Apply JADAM Microorganism Solution (JMS) to the soil 1 week before planting to boost microbial activity. Follow up bi-weekly."
  },
  Tomatoes: {
    icon: <Leaf className="w-6 h-6 text-red-500" />,
    planting: "Bury stems deep (up to the first true leaves) in rich, well-draining soil within pallet raised beds to encourage deep root growth.",
